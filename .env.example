# ==============================================================================
# CLUBOS Environment Configuration (.env.example)
# Copy this file to .env.local for local development.
# Never commit .env.local or secret keys to version control.
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Connection Foundation (Build 02.1)
# Obtain Project URL and Publishable/Anon key from your Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"

# Database Connection (Direct / Pooled - Build 02.2+)
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Cryptographic Session Secret
# SESSION_SECRET="super-secret-cryptographic-key-min-32-chars-long"
